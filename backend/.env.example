# ============================================================
# AI 知识库产品 - 环境变量配置示例
# 复制为 .env 并按需修改。所有配置均有合理默认值，无需真实 API Key 即可运行（Mock 模式）。
# ============================================================

# ---------- 应用基础配置 ----------
APP_NAME="AI Knowledge Base"
APP_ENV=development                 # development / production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                      # DEBUG / INFO / WARNING / ERROR

# 允许跨域的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- LLM 提供商配置 ----------
# 仅保留 DeepSeek 与小米 MiMo，二者均兼容 OpenAI 协议。默认提供商: deepseek / mimo
DEFAULT_LLM_PROVIDER=deepseek

# DeepSeek 深度求索（填入 API Key 后即可调用；也可走硅基流动：base_url=https://api.siliconflow.cn/v1）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 小米 MiMo（OpenAI 兼容端点）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.mimo.chat/v1
MIMO_MODEL=mimo-7b-rl

# ---------- Embedding 嵌入配置 ----------
# 默认使用离线确定性嵌入（mock），零密钥零联网即可跑通 RAG；
# 如需真实语义嵌入，设 EMBEDDING_PROVIDER=openai 并配置硅基流动等 OpenAI 兼容端点：
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_API_KEY=sk-...
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=384            # mock 嵌入维度

# ---------- 向量库配置 ----------
# 本地轻量向量库（numpy 实现），单文件持久化
VECTOR_STORE_PATH=./data/vectorstore.json

# ---------- 重排序（Rerank）配置 ----------
# 两阶段检索：向量召回后用 Cross-Encoder 重排序精排。默认关闭，也可在网页「系统设置」中开启。
RERANK_ENABLED=false
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_K=20              # 重排序前先召回的候选片段数（应 >= RETRIEVAL_TOP_K）
RERANK_TIMEOUT=20                  # 调用重排序 API 超时（秒）

# ---------- 运行时配置 ----------
# 网页端修改的运行时覆盖配置（LLM 密钥/端点、嵌入、重排序）持久化位置。
# .env 作为基线默认，网页保存的改动写入此文件（.env 不被修改）。
RUNTIME_CONFIG_PATH=./data/runtime_config.json

# ---------- RAG 检索配置 ----------
CHUNK_SIZE=500                     # 文本分块大小（字符）
CHUNK_OVERLAP=50                   # 分块重叠字符数
RETRIEVAL_TOP_K=4                  # 检索返回的相关片段数

# 混合检索（向量稠密 + BM25 稀疏 + RRF 融合），提升专有名词/精确匹配召回
HYBRID_SEARCH_ENABLED=true
RRF_K=60                           # RRF 平滑参数（越小排名影响越显著）
HYBRID_DENSE_WEIGHT=1.0            # 向量路权重（语义场景可调高）
HYBRID_SPARSE_WEIGHT=1.0           # 稀疏路权重（精确匹配/专有名词场景可调高）

# ---------- 记忆管理配置 ----------
MEMORY_DB_PATH=./data/memory.db    # SQLite 记忆库路径
MEMORY_TTL_DAYS=30                 # 记忆过期天数（自动清理）
MAX_HISTORY_TURNS=20               # 单会话保留的最大对话轮数

# ---------- 文件上传配置 ----------
UPLOAD_DIR=./data/uploads
# 已取消单文件大小限制（不再使用 MAX_UPLOAD_SIZE_MB）
